<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog writes what the code sends to the regular ILogger (the code does not know NLog).
  Which levels are written is set in appsettings.json / appsettings.Development.json ("Logging:LogLevel"):
  Debug for our code in development, Information otherwise, Warning for Microsoft.
  Here: where the lines go (daily file + console) and how a line looks.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${aspnet-appbasepath}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variables>
    <!-- date | level | CorrelationId ("-" outside a request, e.g. startup) | logger | message, then the exception if any -->
    <variable name="line"
              value="${longdate}|${level:uppercase=true}|${scopeproperty:item=CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />
  </variables>

  <targets>
    <!-- One file per day in SmartRoom.API/logs (ignored by git), kept for 14 days. -->
    <target xsi:type="File" name="file"
            fileName="${aspnet-appbasepath}/logs/smartroom-${shortdate}.log"
            layout="${line}"
            maxArchiveDays="14"
            encoding="utf-8" />

    <target xsi:type="Console" name="console" layout="${line}" />
  </targets>

  <rules>
    <!-- Microsoft: Warning and above only (startup lines such as "Now listening on" are kept). -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="file,console" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Debug" writeTo="file,console" />
  </rules>
</nlog>
