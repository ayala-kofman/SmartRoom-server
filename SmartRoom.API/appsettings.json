{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SmartRoom.API",
    "Audience": "SmartRoom.Client",
    "ExpiryMinutes": 60
  },
  "BookingRules": {
    "DaysAhead": 1,
    "TimeZoneId": "Asia/Jerusalem",
    "ShabbatCloseTime": "12:00",
    "ShabbatOpenTime": "21:00"
  },
  "Paging": {
    "DefaultPageSize": 10,
    "MaxPageSize": 50
  },
  "Cors": {
    "AllowedOrigins": [ "https://smartroom-client.onrender.com" ]
  }
}
